{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flutter-scout.local/evaluation/v1/benchmark_episode.schema.json",
  "title": "Flutter Scout scheduled raw benchmark episode v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "configSha256",
    "scheduleSha256",
    "pairId",
    "repetition",
    "variantSeed",
    "repetitionSeed",
    "conditionOrder",
    "freshResetPerformed",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "configSha256": { "$ref": "#/$defs/sha256" },
    "scheduleSha256": { "$ref": "#/$defs/sha256" },
    "pairId": { "$ref": "#/$defs/id" },
    "repetition": { "type": "integer", "minimum": 1 },
    "variantSeed": { "type": "integer" },
    "repetitionSeed": { "type": "integer", "minimum": 0 },
    "conditionOrder": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "freshResetPerformed": { "type": "boolean" },
    "result": { "$ref": "episode_result.schema.json" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
