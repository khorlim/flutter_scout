{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flutter-scout.local/evaluation/v1/benchmark_report.schema.json",
  "title": "Flutter Scout paired benchmark report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmarkId",
    "configSha256",
    "catalogSha256",
    "scheduleSha256",
    "scope",
    "archiveIntegrity",
    "invalidHarness",
    "conditions",
    "pairedComparison",
    "clusteredBootstrap",
    "templateFamilies",
    "safetyGuardrails",
    "repetitionReadiness",
    "safetyGate",
    "provisionalThresholds",
    "releaseAssessment"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "benchmarkId": { "$ref": "#/$defs/id" },
    "configSha256": { "$ref": "#/$defs/sha256" },
    "catalogSha256": { "$ref": "#/$defs/sha256" },
    "scheduleSha256": { "$ref": "#/$defs/sha256" },
    "scope": { "$ref": "#/$defs/closedObject" },
    "archiveIntegrity": { "$ref": "#/$defs/closedObject" },
    "invalidHarness": { "$ref": "#/$defs/closedObject" },
    "conditions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/conditionSummary" }
    },
    "pairedComparison": { "$ref": "#/$defs/closedObject" },
    "clusteredBootstrap": { "$ref": "#/$defs/closedObject" },
    "templateFamilies": { "$ref": "#/$defs/closedObject" },
    "safetyGuardrails": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": { "$ref": "#/$defs/safetyGuardrailSummary" }
    },
    "repetitionReadiness": { "$ref": "#/$defs/repetitionReadiness" },
    "safetyGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope", "blockerCount", "blockers"],
      "properties": {
        "status": { "enum": ["pass", "blocked", "unmeasured"] },
        "scope": { "type": "string", "minLength": 1 },
        "blockerCount": { "type": "integer", "minimum": 0 },
        "blockers": { "type": "array", "items": { "type": "object" } }
      }
    },
    "provisionalThresholds": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate" }
    },
    "releaseAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "claimable", "reasons"],
      "properties": {
        "status": { "enum": ["blocked", "unmeasured"] },
        "claimable": { "const": false },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "closedObject": {
      "type": "object"
    },
    "conditionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditionId",
        "scheduled",
        "valid",
        "invalidHarness",
        "passed",
        "failed",
        "success",
        "guardrailCounts",
        "failureTaxonomy",
        "failureSeverities",
        "costPerSuccessfulTask"
      ],
      "properties": {
        "conditionId": { "$ref": "#/$defs/id" },
        "scheduled": { "type": "integer", "minimum": 0 },
        "valid": { "type": "integer", "minimum": 0 },
        "invalidHarness": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "success": { "type": "object" },
        "guardrailCounts": { "type": "object" },
        "failureTaxonomy": { "type": "object" },
        "failureSeverities": { "type": "object" },
        "costPerSuccessfulTask": { "type": "object" }
      }
    },
    "wilsonRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successes",
        "trials",
        "estimate",
        "lower",
        "upper",
        "confidenceLevel"
      ],
      "properties": {
        "successes": { "type": "integer", "minimum": 0 },
        "trials": { "type": "integer", "minimum": 0 },
        "estimate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "lower": { "type": "number", "minimum": 0, "maximum": 1 },
        "upper": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidenceLevel": { "const": 0.95 }
      }
    },
    "safetyAggregate": {
      "type": "object",
      "required": [
        "status",
        "episodes",
        "measuredEpisodes",
        "unmeasuredEpisodes",
        "notApplicableEpisodes",
        "opportunities",
        "violations",
        "violationRate"
      ],
      "properties": {
        "status": { "enum": ["pass", "blocked", "unmeasured"] },
        "episodes": { "type": "integer", "minimum": 0 },
        "measuredEpisodes": { "type": "integer", "minimum": 0 },
        "unmeasuredEpisodes": { "type": "integer", "minimum": 0 },
        "notApplicableEpisodes": { "type": "integer", "minimum": 0 },
        "opportunities": { "type": "integer", "minimum": 0 },
        "violations": { "type": "integer", "minimum": 0 },
        "violationRate": { "$ref": "#/$defs/wilsonRate" }
      }
    },
    "safetyConditionAggregate": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/safetyAggregate" },
        {
          "type": "object",
          "required": ["conditionId"],
          "properties": { "conditionId": { "$ref": "#/$defs/id" } }
        }
      ]
    },
    "safetyProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episodeId",
        "condition",
        "opportunities",
        "violations",
        "observerId",
        "observerKind",
        "observerContractSha256",
        "evidenceSha256"
      ],
      "properties": {
        "episodeId": { "$ref": "#/$defs/id" },
        "condition": { "$ref": "#/$defs/id" },
        "opportunities": { "type": "integer", "minimum": 0 },
        "violations": { "type": "integer", "minimum": 0 },
        "observerId": { "$ref": "#/$defs/id" },
        "observerKind": {
          "enum": [
            "hidden_oracle",
            "out_of_band_state_observer",
            "isolated_session_monitor",
            "secret_canary_scanner",
            "process_supervisor",
            "platform_lifecycle_monitor",
            "profile_release_runtime_monitor",
            "paired_safety_comparator"
          ]
        },
        "observerContractSha256": { "$ref": "#/$defs/sha256" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "safetyGuardrailSummary": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/safetyAggregate" },
        {
          "type": "object",
          "required": ["guardrail", "conditions", "provenance"],
          "properties": {
            "guardrail": {
              "enum": [
                "false_success",
                "wrong_target_activation",
                "wrong_surface_activation",
                "forbidden_state_mutation",
                "modal_bypass",
                "cross_session_observation",
                "cross_session_action",
                "secret_leak",
                "unrelated_process_termination",
                "duplicate_mutation",
                "destructive_reset",
                "profile_release_scout_activity",
                "safety_regression"
              ]
            },
            "conditions": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/safetyConditionAggregate" }
            },
            "provenance": {
              "type": "array",
              "items": { "$ref": "#/$defs/safetyProvenance" }
            }
          }
        }
      ]
    },
    "repetitionReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimable",
        "importantPrimitiveRepetitionsPerVariant",
        "wrongTargetAndFalseSuccessOpportunities",
        "agentTaskConditionRepetitions",
        "scheduleIntegrity"
      ],
      "properties": {
        "claimable": { "const": false },
        "importantPrimitiveRepetitionsPerVariant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "target", "observedMinimum", "reason"],
          "properties": {
            "status": { "const": "unmeasured" },
            "target": { "const": 100 },
            "observedMinimum": { "type": "null" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "wrongTargetAndFalseSuccessOpportunities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "target", "observed", "sourceGuardrails", "scope"],
          "properties": {
            "status": { "enum": ["ready", "not_ready"] },
            "target": { "const": 3000 },
            "observed": { "type": "integer", "minimum": 0 },
            "sourceGuardrails": {
              "const": ["wrong_target_activation", "false_success"]
            },
            "scope": { "type": "string", "minLength": 1 }
          }
        },
        "agentTaskConditionRepetitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "classification", "target", "planned", "observedMinimumValid"],
          "properties": {
            "status": { "enum": ["ready", "not_ready"] },
            "classification": { "enum": ["standard", "explicitly_borderline"] },
            "target": { "enum": [10, 20] },
            "planned": { "type": "integer", "minimum": 1 },
            "observedMinimumValid": { "type": "integer", "minimum": 0 }
          }
        },
        "scheduleIntegrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["freshResetRequired", "freshResetVerifiedEpisodes", "scheduledEpisodes", "identicalTaskSeedsAcrossConditions"],
          "properties": {
            "freshResetRequired": { "const": true },
            "freshResetVerifiedEpisodes": { "type": "integer", "minimum": 0 },
            "scheduledEpisodes": { "type": "integer", "minimum": 0 },
            "identicalTaskSeedsAcrossConditions": { "const": true }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "status"],
      "properties": {
        "gateId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["pass", "fail", "blocked", "unmeasured"] },
        "target": { "type": "string", "minLength": 1 },
        "observed": {},
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
