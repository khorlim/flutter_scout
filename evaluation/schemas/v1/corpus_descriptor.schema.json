{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flutter-scout.local/evaluation/v1/corpus_descriptor.schema.json",
  "title": "Flutter Scout corpus descriptor v1",
  "description": "Private benchmark metadata. This document must never be sent to an evaluated agent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "corpusVersion", "templates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusId": { "$ref": "#/$defs/id" },
    "corpusVersion": { "type": "string", "minLength": 1 },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "family": {
      "enum": [
        "forms",
        "lists",
        "grids",
        "nested_scroll",
        "tabs",
        "dialogs_sheets_menus",
        "pickers",
        "custom_painted",
        "gesture",
        "lifecycle_reconnect",
        "faults",
        "security_privacy"
      ]
    },
    "perturbation": {
      "enum": [
        "viewport",
        "device_pixel_ratio",
        "orientation",
        "content_order",
        "content_length",
        "initial_scroll_state",
        "initial_tab_state",
        "initial_modal_state",
        "initial_focus_state",
        "animation_delay",
        "network_delay",
        "semantics_degradation",
        "key_degradation"
      ]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appId", "displayName", "kind", "source", "revision"],
      "properties": {
        "appId": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["stress_lab", "real_application"] },
        "source": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "variantId",
        "semanticsPreserving",
        "perturbationDimensions"
      ],
      "properties": {
        "taskId": { "$ref": "#/$defs/id" },
        "variantId": { "$ref": "#/$defs/id" },
        "semanticsPreserving": { "type": "boolean" },
        "perturbationDimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/perturbation" }
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "app", "families", "variants"],
      "properties": {
        "templateId": { "$ref": "#/$defs/id" },
        "app": { "$ref": "#/$defs/app" },
        "families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/family" }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    }
  }
}
