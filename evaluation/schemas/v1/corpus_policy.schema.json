{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flutter-scout.local/evaluation/v1/corpus_policy.schema.json",
  "title": "Flutter Scout gold corpus policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "minimumTemplateCount",
    "minimumVariantsPerTemplate",
    "minimumTemplatesPerRequiredFamily",
    "minimumRealAppIdentitiesBeyondStressLab",
    "requiredFamilies",
    "requiredPerturbationDimensions",
    "requiredSplits",
    "stressLabAppIds"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "policyId": { "$ref": "#/$defs/id" },
    "minimumTemplateCount": { "type": "integer", "minimum": 1 },
    "minimumVariantsPerTemplate": { "type": "integer", "minimum": 1 },
    "minimumTemplatesPerRequiredFamily": {
      "type": "integer",
      "minimum": 1
    },
    "minimumRealAppIdentitiesBeyondStressLab": {
      "type": "integer",
      "minimum": 1
    },
    "requiredFamilies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/family" }
    },
    "requiredPerturbationDimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/perturbation" }
    },
    "requiredSplits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public_development",
          "private_validation",
          "frozen_hidden_release"
        ]
      }
    },
    "stressLabAppIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "family": {
      "enum": [
        "forms",
        "lists",
        "grids",
        "nested_scroll",
        "tabs",
        "dialogs_sheets_menus",
        "pickers",
        "custom_painted",
        "gesture",
        "lifecycle_reconnect",
        "faults",
        "security_privacy"
      ]
    },
    "perturbation": {
      "enum": [
        "viewport",
        "device_pixel_ratio",
        "orientation",
        "content_order",
        "content_length",
        "initial_scroll_state",
        "initial_tab_state",
        "initial_modal_state",
        "initial_focus_state",
        "animation_delay",
        "network_delay",
        "semantics_degradation",
        "key_degradation"
      ]
    }
  }
}
