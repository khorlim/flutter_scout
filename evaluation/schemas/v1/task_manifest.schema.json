{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flutter-scout.local/evaluation/v1/task_manifest.schema.json",
  "title": "Flutter Scout evaluation task manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "templateId",
    "split",
    "agentVisible",
    "hiddenHarness",
    "variant"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "$ref": "#/$defs/id" },
    "templateId": { "$ref": "#/$defs/id" },
    "split": {
      "enum": [
        "public_development",
        "private_validation",
        "frozen_hidden_release"
      ]
    },
    "agentVisible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "allowedTools", "budget"],
      "properties": {
        "instruction": { "type": "string", "minLength": 1 },
        "allowedTools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "budget": { "$ref": "#/$defs/budget" }
      }
    },
    "hiddenHarness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracleId",
        "setupFixture",
        "successPredicateIds",
        "forbiddenPredicateIds",
        "teardownFixture"
      ],
      "properties": {
        "oracleId": { "$ref": "#/$defs/id" },
        "setupFixture": { "$ref": "#/$defs/id" },
        "successPredicateIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "forbiddenPredicateIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "teardownFixture": { "$ref": "#/$defs/id" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variantId", "seed", "parameters"],
      "properties": {
        "variantId": { "$ref": "#/$defs/id" },
        "seed": { "type": "integer" },
        "parameters": { "type": "object" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxActions", "maxWallTimeMs"],
      "properties": {
        "maxActions": { "type": "integer", "minimum": 1 },
        "maxWallTimeMs": { "type": "integer", "minimum": 1 },
        "maxTokens": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
