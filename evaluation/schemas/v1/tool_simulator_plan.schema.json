{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flutter-scout.local/evaluation/v1/tool_simulator_plan.schema.json",
  "title": "Flutter Scout public tool-simulator action plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "episodeId",
    "condition",
    "agentClaimedSuccess",
    "actions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "episodeId": { "$ref": "#/$defs/id" },
    "condition": { "$ref": "#/$defs/id" },
    "agentClaimedSuccess": { "type": "boolean" },
    "reportedTokens": { "type": "integer", "minimum": 0 },
    "actions": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arguments"],
      "properties": {
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "prefixItems": [
            {
              "enum": ["inspect", "tap", "input", "fill", "wait"]
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000\\r\\n]+$"
          }
        }
      }
    }
  }
}
