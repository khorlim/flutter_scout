{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flutter-scout.dev/protocol/schemas/v1/cli-heartbeat.schema.json",
  "title": "Flutter Scout structured long-operation heartbeat",
  "type": "object",
  "maxProperties": 1024,
  "required": [
    "messageType",
    "ok",
    "schemaVersion",
    "protocolVersion",
    "minSupportedProtocolVersion",
    "maxSupportedProtocolVersion",
    "protocolRange",
    "capabilities",
    "commandId",
    "cliCommandId",
    "runId",
    "runtimeInstanceId",
    "stateGeneration",
    "identityStatus",
    "identityAvailability",
    "result",
    "structuredError",
    "timings",
    "stage",
    "elapsedMs",
    "heartbeatCursor",
    "progress",
    "logCursor",
    "payloadBounds"
  ],
  "properties": {
    "messageType": {"const": "heartbeat"},
    "ok": {"const": true},
    "schemaVersion": {"const": 1},
    "protocolVersion": {"const": 15},
    "minSupportedProtocolVersion": {"const": 15},
    "maxSupportedProtocolVersion": {"const": 15},
    "protocolRange": {"type": "object"},
    "capabilities": {"type": "object"},
    "commandId": {"type": ["string", "null"]},
    "cliCommandId": {"type": ["string", "null"]},
    "runId": {"type": ["string", "null"]},
    "runtimeInstanceId": {"type": ["string", "null"]},
    "stateGeneration": {"type": ["integer", "null"], "minimum": 0},
    "identityStatus": {"type": "string"},
    "identityAvailability": {"type": "object"},
    "result": {"type": "object"},
    "structuredError": {"type": "null"},
    "timings": {
      "type": "object",
      "required": ["elapsedMs", "totalMs", "status"],
      "properties": {
        "elapsedMs": {"type": "integer", "minimum": 0},
        "totalMs": {"type": "null"},
        "status": {"const": "in_progress"}
      }
    },
    "stage": {"type": "string", "minLength": 1, "maxLength": 256},
    "elapsedMs": {"type": "integer", "minimum": 0},
    "heartbeatCursor": {"type": "integer", "minimum": 1},
    "progress": {"type": "object", "maxProperties": 128},
    "logCursor": {"type": "integer", "minimum": 0},
    "payloadBounds": {"type": "object"}
  },
  "additionalProperties": true
}
